param (
    [string]$RFC_LIST = $env:RFC_LIST,
    [string]$CAB_DATE = $env:CAB_DATE,
    [string]$ReportPath = ".\RFC_Post_CAB_Changes.csv"
)
 
$ErrorActionPreference = "Stop"
 
# ============================================================
# GitLab Configuration
# ============================================================
 
$GitLabURL = "https://gitlab.xxxxxxxx.com"
 
$GitLabToken = Select-String `
    -Path "\\yourpath\Cred\gitlab-config.properties" `
    -Pattern "YOUR_TOKEN_PATTERN" |
    ForEach-Object {
        ($_ -split '=')[1].Trim()
    }
 
$headers = @{
    "PRIVATE-TOKEN" = $GitLabToken
    "Content-Type"  = "application/json"
}
 
 
# ============================================================
# Deployment Plan repository
# ============================================================
 
$DPProjectPath = "repos/common/DeploymentPlans"
 
$EncodedDPProjectPath = [System.Uri]::EscapeDataString(
    $DPProjectPath
)
 
$DPRef = "integration"
 
$EncodedDPRef = [System.Uri]::EscapeDataString(
    $DPRef
)
 
 
# ============================================================
# Validate RFC input
# ============================================================
 
if ([string]::IsNullOrWhiteSpace($RFC_LIST)) {
    Write-Host "ERROR: RFC_LIST is empty"
    exit 1
}
 
$RFC_LIST = $RFC_LIST.Split(",") |
    ForEach-Object {
        $_.Trim()
    } |
    Where-Object {
        -not [string]::IsNullOrWhiteSpace($_)
    }
 
 
# ============================================================
# CAB Date
#
# User passes:
# CAB_DATE = 2026-11-03
#
# Script automatically considers:
# 09:00 AM Eastern
#
# If CAB_DATE is empty:
# today's date is used.
# ============================================================
 
try {
    $EasternTimeZone = [System.TimeZoneInfo]::FindSystemTimeZoneById(
        "Eastern Standard Time"
    )
}
catch {
    $EasternTimeZone = [System.TimeZoneInfo]::FindSystemTimeZoneById(
        "America/New_York"
    )
}
 
 
# Get current date in Eastern Time
$EasternNow = [System.TimeZoneInfo]::ConvertTimeFromUtc(
    [DateTime]::UtcNow,
    $EasternTimeZone
)
 
 
if ([string]::IsNullOrWhiteSpace($CAB_DATE)) {
 
    $CabDateValue = $EasternNow.Date
 
    Write-Host "CAB_DATE not provided."
    Write-Host "Using current Eastern date: $($CabDateValue.ToString('yyyy-MM-dd'))"
}
else {
 
    try {
        $CabDateValue = [DateTime]::ParseExact(
            $CAB_DATE,
            "yyyy-MM-dd",
            [System.Globalization.CultureInfo]::InvariantCulture
        )
    }
    catch {
        Write-Host "ERROR: CAB_DATE must be yyyy-MM-dd"
        exit 1
    }
}
 
 
# Add fixed CAB time: 09:00 AM
$CabEasternTime = [DateTime]::SpecifyKind(
    $CabDateValue.Date.AddHours(9),
    [DateTimeKind]::Unspecified
)
 
 
# Convert Eastern CAB time to UTC
$CabUtcTime = [System.TimeZoneInfo]::ConvertTimeToUtc(
    $CabEasternTime,
    $EasternTimeZone
)
 
$CabUtcString = $CabUtcTime.ToString(
    "yyyy-MM-ddTHH:mm:ssZ"
)
 
 
Write-Host ""
Write-Host "============================================="
Write-Host "CAB Date/Time Check"
Write-Host "============================================="
Write-Host "CAB Date    : $($CabDateValue.ToString('yyyy-MM-dd'))"
Write-Host "CAB Time    : 09:00 AM Eastern"
Write-Host "CAB UTC     : $CabUtcString"
Write-Host "RFCs        : $($RFC_LIST -join ', ')"
Write-Host "============================================="
Write-Host ""
 
 
# ============================================================
# Results
# ============================================================
 
$Results = @()
 
 
# ============================================================
# Process every RFC
# ============================================================
 
foreach ($RFC in $RFC_LIST) {
 
    Write-Host ""
    Write-Host "================================================"
    Write-Host "Processing RFC: $RFC"
    Write-Host "================================================"
 
 
    # ========================================================
    # Get deployment plan XML from GitLab
    # ========================================================
 
    $FilePath = "$RFC.xml"
 
    $EncodedFilePath = [System.Uri]::EscapeDataString(
        $FilePath
    )
 
    $FileApiUrl = "$GitLabURL/api/v4/projects/$EncodedDPProjectPath/repository/files/$EncodedFilePath" +
                  "?ref=$EncodedDPRef"
 
 
    try {
 
        $DPResponse = Invoke-RestMethod `
            -Uri $FileApiUrl `
            -Method Get `
            -Headers $headers
 
 
        $xmlContentString = [System.Text.Encoding]::UTF8.GetString(
            [System.Convert]::FromBase64String(
                $DPResponse.content
            )
        )
 
 
        [xml]$XmlContent = $xmlContentString
 
    }
    catch {
 
        Write-Host "ERROR: Unable to read Deployment Plan for $RFC"
        Write-Host $_.Exception.Message
 
        $Results += [PSCustomObject]@{
            RFC              = $RFC
            DeploymentID     = ""
            Repository       = ""
            Branch           = ""
            CABDate          = $CabDateValue.ToString("yyyy-MM-dd")
            CABTime          = "09:00 AM Eastern"
            CommitsAfterCAB  = 0
            Status           = "DEPLOYMENT_PLAN_ERROR"
            LastCommitSHA    = ""
            LastCommitter    = ""
            LastCommitDate   = ""
            LastCommitTitle  = ""
            Error            = $_.Exception.Message
        }
 
        continue
    }
 
 
    # ========================================================
    # Deployment ID
    # ========================================================
 
    $DeploymentId = $XmlContent.deployment.id
 
    Write-Host "Deployment ID: $DeploymentId"
 
 
    # ========================================================
    # Get repositories from XML
    # ========================================================
 
    $Repositories = @(
        $XmlContent.deployment.scm.repository
    )
 
 
    if (!$Repositories -or $Repositories.Count -eq 0) {
 
        Write-Host "ERROR: No Repository entries found under deployment/scm"
 
        $Results += [PSCustomObject]@{
            RFC              = $RFC
            DeploymentID     = $DeploymentId
            Repository       = ""
            Branch           = ""
            CABDate          = $CabDateValue.ToString("yyyy-MM-dd")
            CABTime          = "09:00 AM Eastern"
            CommitsAfterCAB  = 0
            Status           = "NO_REPOSITORIES"
            LastCommitSHA    = ""
            LastCommitter    = ""
            LastCommitDate   = ""
            LastCommitTitle  = ""
            Error            = "No Repository entries found"
        }
 
        continue
    }
 
 
    Write-Host "Total Repositories found in XML: $($Repositories.Count)"
 
 
    # ========================================================
    # Process repositories
    # ========================================================
 
    foreach ($Repo in $Repositories) {
 
        try {
 
            $RepoURL = [string]$Repo.url
            $SourceBranch = [string]$Repo.branch
 
 
            if (
                [string]::IsNullOrWhiteSpace($RepoURL) -or
                [string]::IsNullOrWhiteSpace($SourceBranch)
            ) {
 
                Write-Host "Skipping Repository because URL or Branch is empty"
 
                continue
            }
 
 
            # Remove refs/heads/ if present
            $CleanBranch = $SourceBranch.Replace(
                "refs/heads/",
                ""
            ).Trim()
 
 
            # =================================================
            # Skip branches we do not want to check
            # =================================================
 
            $IgnoreBranches = @(
                "main",
                "master",
                "integration"
            )
 
 
            if ($IgnoreBranches -contains $CleanBranch.ToLower()) {
 
                Write-Host "Skipping branch $SourceBranch because it is main/master/integration"
 
                continue
            }
 
 
            # =================================================
            # Get Repository Name
            # =================================================
 
            $RepoName = (
                $RepoURL.Split("/")[-1]
            ).Replace(
                ".git",
                ""
            )
 
 
            # =================================================
            # Get Project Path
            #
            # Example:
            #
            # https://gitlab.xxx.com/repos/app/ABC.git
            #
            # Becomes:
            #
            # repos/app/ABC
            # =================================================
 
            $Uri = [System.Uri]$RepoURL
 
            $ProjectPath = $Uri.AbsolutePath.TrimStart("/")
 
            if ($ProjectPath.EndsWith(".git")) {
 
                $ProjectPath = $ProjectPath.Substring(
                    0,
                    $ProjectPath.Length - 4
                )
            }
 
 
            $EncodedProjectPath = [System.Uri]::EscapeDataString(
                $ProjectPath
            )
 
            $EncodedSourceBranch = [System.Uri]::EscapeDataString(
                $CleanBranch
            )
 
            $EncodedCabDate = [System.Uri]::EscapeDataString(
                $CabUtcString
            )
 
 
            Write-Host ""
            Write-Host "Repository : $RepoName"
            Write-Host "Branch     : $CleanBranch"
            Write-Host "Project    : $ProjectPath"
 
 
            # =================================================
            # GitLab Commits API
            #
            # This DOES NOT clone the repository.
            #
            # GitLab checks the branch directly and returns
            # commits after our CAB cutoff.
            # =================================================
 
            $CommitApiUrl = "$GitLabURL/api/v4/projects/$EncodedProjectPath/repository/commits" +
                            "?ref_name=$EncodedSourceBranch" +
                            "&since=$EncodedCabDate" +
                            "&per_page=100"
 
 
            $Commits = @(
                Invoke-RestMethod `
                    -Uri $CommitApiUrl `
                    -Method Get `
                    -Headers $headers
            )
 
 
            # =================================================
            # Strict check:
            #
            # committed_date must actually be > CAB time.
            # =================================================
 
            $CommitsAfterCAB = @(
                $Commits | Where-Object {
 
                    $CommitDate = [DateTimeOffset]::Parse(
                        $_.committed_date
                    )
 
                    $CommitDate.UtcDateTime -gt $CabUtcTime
                }
            )
 
 
            # =================================================
            # Changes found
            # =================================================
 
            if ($CommitsAfterCAB.Count -gt 0) {
 
                $LatestCommit = $CommitsAfterCAB |
                    Sort-Object {
                        [DateTimeOffset]::Parse(
                            $_.committed_date
                        )
                    } -Descending |
                    Select-Object -First 1
 
 
                Write-Host "STATUS     : CHANGE FOUND"
                Write-Host "Commit(s)  : $($CommitsAfterCAB.Count)"
                Write-Host "Last SHA   : $($LatestCommit.short_id)"
                Write-Host "Committer  : $($LatestCommit.committer_name)"
                Write-Host "Date       : $($LatestCommit.committed_date)"
                Write-Host "Message    : $($LatestCommit.title)"
 
 
                $Results += [PSCustomObject]@{
 
                    RFC              = $RFC
 
                    DeploymentID     = $DeploymentId
 
                    Repository       = $RepoName
 
                    Branch           = $CleanBranch
 
                    CABDate          = $CabDateValue.ToString(
                        "yyyy-MM-dd"
                    )
 
                    CABTime          = "09:00 AM Eastern"
 
                    CommitsAfterCAB  = $CommitsAfterCAB.Count
 
                    Status           = "CHANGE_FOUND"
 
                    LastCommitSHA    = $LatestCommit.short_id
 
                    LastCommitter    = $LatestCommit.committer_name
 
                    LastCommitDate   = $LatestCommit.committed_date
 
                    LastCommitTitle  = $LatestCommit.title
 
                    Error            = ""
                }
            }
 
 
            # =================================================
            # No changes
            # =================================================
 
            else {
 
                Write-Host "STATUS     : NO CHANGE"
                Write-Host "No commits found after CAB."
 
 
                $Results += [PSCustomObject]@{
 
                    RFC              = $RFC
 
                    DeploymentID     = $DeploymentId
 
                    Repository       = $RepoName
 
                    Branch           = $CleanBranch
 
                    CABDate          = $CabDateValue.ToString(
                        "yyyy-MM-dd"
                    )
 
                    CABTime          = "09:00 AM Eastern"
 
                    CommitsAfterCAB  = 0
 
   ommitsAfterCAB  = 0
 
              mitDate   = ""
 
                    LastCommitTitle  = ""
 
                    Error            = ""
                }
            }
 
        }
        catch {
 
            Write-Host "ERROR processing repository:"
            Write-Host $RepoURL
            Write-Host $_.Exception.Message
 
 
            $Results += [PSCustomObject]@{
 
                RFC              = $RFC
 
                DeploymentID     = $DeploymentId
 
                Repository       = $RepoName
 
                Branch           = $SourceBranch
 
                CABDate          = $CabDateValue.ToString(
                    "yyyy-MM-dd"
                )
 
                CABTime          = "09:00 AM Eastern"
 
                CommitsAfterCAB  = 0
 
                Status           = "ERROR"
 
                LastCommitSHA    = ""
 
                LastCommitter    = ""
 
                LastCommitDate   = ""
 
                LastCommitTitle  = ""
 
                Error            = $_.Exception.Message
            }
 
 
            # Important:
            # Continue checking remaining repositories.
            continue
        }
    }
}
 
 
# ============================================================
# Export CSV
# ============================================================
 
$Results |
    Export-Csv `
        -Path $ReportPath `
        -NoTypeInformation `
        -Encoding UTF8
 
 
# ============================================================
# Display Summary
# ============================================================
 
Write-Host ""
Write-Host "================================================"
Write-Host "CAB VALIDATION SUMMARY"
Write-Host "================================================"
 
 
$Results |
    Select-Object `
        RFC,
        Repository,
        Branch,
        CommitsAfterCAB,
        Status |
    Format-Table -AutoSize
 
 
$Changes = @(
    $Results |
        Where-Object {
            $_.Status -eq "CHANGE_FOUND"
        }
)
 
 
$NoChanges = @(
    $Results |
        Where-Object {
            $_.Status -eq "NO_CHANGE"
        }
)
 
 
$Errors = @(
    $Results |
        Where-Object {
            $_.Status -in @(
                "ERROR",
                "DEPLOYMENT_PLAN_ERROR",
                "NO_REPOSITORIES"
            )
        }
)
 
 
Write-Host ""
Write-Host "Total RFCs             : $($RFC_LIST.Count)"
Write-Host "Repositories Checked   : $($Changes.Count + $NoChanges.Count)"
Write-Host "No Change              : $($NoChanges.Count)"
Write-Host "Changes After CAB      : $($Changes.Count)"
Write-Host "Errors                 : $($Errors.Count)"
Write-Host ""
Write-Host "Report                  : $ReportPath"
Write-Host ""
 
 
# ============================================================
# Basic tracking only
#
# Changes do not fail Jenkins.
# Actual processing/API errors can fail Jenkins.
# ============================================================
 
if ($Errors.Count -gt 0) {
 
    Write-Host "CAB validation completed with errors."
    exit 1
}
 
 
if ($Changes.Count -gt 0) {
 
    Write-Warning "Changes were detected after CAB approval."
 
    # We are only tracking currently.
    # Therefore don't fail the Jenkins build.
 
    exit 0
}
 
 
Write-Host "No changes were found after CAB approval."
 
exit 0
